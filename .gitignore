# Default-deny: only allow-listed paths are tracked. See tools/check_repo.py.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.githooks/
!/src/
!/tests/
!/tools/
!/docs/
!/README.md
!/CLAUDE.md
!/LICENSE
!/pyproject.toml
!/uv.lock
!/.python-version

# Personal data and secrets are never tracked, even inside allowed dirs.
*.jp*g
*.png
*.gif
*.webp
*.heic
*.heif
*.avif
*.tif*
*.dng
*.bmp
*.mp4
*.mov
*.3gp
*.zip
*.7z
*.tar
*.gz
*.tgz
*.sqlite*
*.db
*.db-*
*.npy
*.npz
*.bin
*.pt
*.pth
*.safetensors
*.onnx
*.json
*.jsonl
*.csv
*.log
*.conf
.env*
*.pem
*.key
*.token
__pycache__/
.venv/
